{
  "manifest_version": 3,
  "name": "ClipCut OS Manager",
  "version": "1.0.0",
  "description": "Background connector for ClipCut Earning OS — campaigns, daily targets, clip logging, Whop/ClipCut shortcuts, net CPM math.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://whop.com/*",
    "https://*.whop.com/*",
    "https://www.clipcut.pro/*",
    "https://clipcut.pro/*",
    "https://clippingalpha.com/*",
    "https://clippingatlas.xyz/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ClipCut OS Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://whop.com/*",
        "https://*.whop.com/*"
      ],
      "js": ["content/whop-helper.js"],
      "run_at": "document_idle"
    }
  ]
}
